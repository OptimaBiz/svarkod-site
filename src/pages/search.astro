import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Поиск — СВАРКОД"><header class="page-hero shell"><p class="eyebrow">По всей системе</p><h1>Поиск</h1><form class="search-form"><label class="sr-only" for="q">Поисковый запрос</label><input id="q" name="q" type="search" placeholder="Документ, тема, организация…" autofocus/><button class="button">Найти</button></form><p class="search-hint">Ищите по материалам редакции, нормативным документам, рейтингу и форуму.</p></header></BaseLayout>
