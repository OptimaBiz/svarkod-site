---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../lib/content';

const documents = (await getCollection('documents', ({ data }) => !data.draft))
  .sort((a, b) => b.data.updatedAt.getTime() - a.data.updatedAt.getTime());
---
<BaseLayout title="Документы — СВАРКОД" description="Редакционный каталог нормативных и справочных источников СВАРКОД с отметкой о проверке и актуальности.">
  <header class="page-hero shell"><p class="eyebrow">Первоисточники и методика</p><h1>Документы</h1><p>Каталог строится по принципу проверяемости: карточка не заменяет официальный источник, а помогает найти его и понять редакционный статус.</p></header>
  <section class="shell section-block"><div class="cards-grid">{documents.map(document => <article class="service-card"><span>{document.data.status}</span><h2><a href={`/documents/${document.id}/`}>{document.data.title}</a></h2><p>{document.data.description}</p><div class="meta"><span>{document.data.category}</span><time datetime={document.data.updatedAt.toISOString()}>Проверено {formatDate(document.data.updatedAt)}</time></div><a href={`/documents/${document.id}/`}>Открыть →</a></article>)}</div></section>
</BaseLayout>
