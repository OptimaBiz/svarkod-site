---
const { article, lead = false, compact = false } = Astro.props;
const href = `/articles/${article.slug}/`;
---
<article class:list={['story-card', { lead, compact }]}>
  <a class="story-art" href={href} aria-label={article.title}><span class="story-monogram">{article.section?.slice(0,1)}</span><span class="story-art-label">{article.section}</span></a>
  <div class="story-copy"><div class="story-meta"><span>{article.section}</span><time>{article.date}</time>{article.read && <span>{article.read}</span>}</div><h3><a href={href}>{article.title}</a></h3>{!compact && <p>{article.lead}</p>}</div>
</article>
