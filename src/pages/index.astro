---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { articles } from '../data/site';
---
<BaseLayout>
  <section class="hero shell"><div class="hero-copy"><p class="eyebrow">Сварка на опасных производственных объектах</p><h1>Разбираем правила.<br/><em>Показываем практику.</em></h1><p class="hero-lead">Независимое отраслевое издание о технологиях сварки, промышленной безопасности и нормативном регулировании.</p><div class="hero-actions"><a class="button" href="/norms/">Перейти к нормам</a><a class="text-link" href="/about/">О проекте <span>→</span></a></div></div><aside class="issue"><span class="issue-num">01</span><p>В фокусе</p><h2>Сварка на ОПО: требования, ответственность, практика</h2><ul><li><a href="/articles/novye-trebovaniya-k-svarke-na-opo/">Изменения требований</a></li><li><a href="/practice/">Производственный контроль</a></li><li><a href="/ratings/">Аттестационные центры</a></li></ul></aside></section>
  <section class="ticker"><div class="shell"><strong>Сейчас важно</strong><a href="/articles/novye-trebovaniya-k-svarke-na-opo/">Новые требования к организации сварочных работ на ОПО: редакционный разбор</a><span>11.08.2026</span></div></section>
  <section class="shell section-block"><div class="section-head"><div><p class="eyebrow">Редакция рекомендует</p><h2>Главное за неделю</h2></div><a class="text-link" href="/news/">Все материалы →</a></div><div class="lead-grid"><ArticleCard article={articles[0]} large /><div class="side-list">{articles.slice(1,4).map(article => <ArticleCard article={article} />)}</div></div></section>
  <section class="dark-section"><div class="shell"><div class="section-head inverse"><div><p class="eyebrow light">Навигатор специалиста</p><h2>От нормы к решению</h2></div><p>Три слоя контента помогают быстро понять требование и применить его в работе.</p></div><div class="pillar-grid"><a href="/norms/"><span>01</span><h3>Нормы</h3><p>Документы, изменения и понятные разъяснения.</p><b>Изучить требования →</b></a><a href="/practice/"><span>02</span><h3>Практика</h3><p>Технологии, контроль и рабочие материалы.</p><b>Найти решение →</b></a><a href="/services/"><span>03</span><h3>Услуги</h3><p>Экспертная поддержка для конкретной задачи.</p><b>Обсудить задачу →</b></a></div></div></section>
  <section class="shell section-block"><div class="section-head"><div><p class="eyebrow">Доверие отрасли</p><h2>Рейтинги СВАРКОД</h2></div><a class="text-link" href="/ratings/">Все рейтинги →</a></div><div class="rating-feature"><div><span class="rating-label">Открытое голосование</span><h3>Рейтинг аттестационных центров — 2026</h3><p>Оцениваем качество сервиса, прозрачность процессов и опыт взаимодействия специалистов.</p><a class="button" href="/ratings/">Посмотреть рейтинг</a></div><div class="score"><strong>128</strong><span>организаций</span><strong>2 846</strong><span>проверенных голосов</span></div></div></section>
</BaseLayout>
