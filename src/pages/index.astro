---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { sortArticles, toArticleCard } from '../lib/content';

const entries = sortArticles(await getCollection('articles', ({ data }) => !data.draft));
const articles = entries.map(toArticleCard);
---
<BaseLayout>
  <section class="hero shell"><div class="hero-copy"><p class="eyebrow">Сварка на опасных производственных объектах</p><h1>Разбираем правила.<br/><em>Показываем практику.</em></h1><p class="hero-lead">Независимое отраслевое издание о технологиях сварки, промышленной безопасности и нормативном регулировании.</p><div class="hero-actions"><a class="button" href="/norms/">Перейти к нормам</a><a class="text-link" href="/about/">О проекте <span>→</span></a></div></div><aside class="issue"><span class="issue-num">01</span><p>В фокусе</p><h2>Сварка на ОПО: требования, ответственность, практика</h2><ul><li><a href="/articles/novye-trebovaniya-k-svarke-na-opo/">Как разбирать изменения требований</a></li><li><a href="/documents/">Каталог документов</a></li><li><a href="/ratings/">Методика рейтингов</a></li></ul></aside></section>
  <section class="ticker"><div class="shell"><strong>Сейчас важно</strong><a href="/articles/novye-trebovaniya-k-svarke-na-opo/">Редакционная схема проверки изменений требований к сварочным работам на ОПО</a><span>11.08.2026</span></div></section>
  <section class="shell section-block"><div class="section-head"><div><p class="eyebrow">Редакция рекомендует</p><h2>Стартовые материалы</h2></div><a class="text-link" href="/news/">Все материалы →</a></div><div class="lead-grid">{articles[0] && <ArticleCard article={articles[0]} large />}<div class="side-list">{articles.slice(1,4).map(article => <ArticleCard article={article} />)}</div></div></section>
  <section class="dark-section"><div class="shell"><div class="section-head inverse"><div><p class="eyebrow light">Навигатор специалиста</p><h2>От нормы к решению</h2></div><p>Разделяем первоисточники, редакционный разбор и практическое применение, чтобы читателю было понятно, где факт, а где интерпретация.</p></div><div class="pillar-grid"><a href="/norms/"><span>01</span><h3>Нормы</h3><p>Изменения требований и редакционные разъяснения.</p><b>Изучить →</b></a><a href="/documents/"><span>02</span><h3>Документы</h3><p>Каталог источников с отметкой актуальности.</p><b>Открыть каталог →</b></a><a href="/practice/"><span>03</span><h3>Практика</h3><p>Технологии, контроль и рабочие подходы.</p><b>Найти решение →</b></a></div></div></section>
  <section class="shell section-block"><div class="section-head"><div><p class="eyebrow">Доверие отрасли</p><h2>Рейтинги СВАРКОД</h2></div><a class="text-link" href="/ratings/">Статус запуска →</a></div><div class="rating-feature"><div><span class="rating-label">Подготовка методики</span><h3>Рейтинги без демонстрационных мест и голосов</h3><p>До запуска публикуем только принципы, статус подготовки и требования к проверяемости. Реальные позиции появятся после утверждения методики и механизма верификации.</p><a class="button" href="/ratings/">Подробнее</a></div><div class="score"><strong>0</strong><span>публичных мест до запуска</span><strong>3</strong><span>обязательных слоя проверки</span></div></div></section>
</BaseLayout>
