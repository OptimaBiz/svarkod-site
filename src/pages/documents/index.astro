---
import { getCollection } from 'astro:content'; import BaseLayout from '../../layouts/BaseLayout.astro'; import {demoDocuments} from '../../demo-data'; import {formatDate} from '../../lib/content';
const real=(await getCollection('documents',({data})=>!data.draft)).map(d=>({id:d.id,kind:d.data.category,status:d.data.status,title:d.data.title,summary:d.data.description,checked:formatDate(d.data.updatedAt),demo:false})); const docs=demoDocuments.length?demoDocuments.map(d=>({...d,demo:true})):real;
---
<BaseLayout title="Документы — СВАРКОД"><header class="section-hero shell"><span class="kicker">БАЗА</span><h1>Документы</h1><p>Первоисточники, статус, дата сверки и редакционные пояснения — в одной карточке.</p></header><section class="shell directory-shell"><div class="filter-bar"><input id="doc-q" placeholder="Название или тип документа"/><select id="doc-status"><option value="">Все статусы</option><option>Действует</option><option>Изменён</option><option>Редакционная</option><option>Справка</option></select><span><strong id="doc-count">{docs.length}</strong> карточек</span></div><div class="document-table">{docs.map(d=><article data-doc data-search={`${d.title} ${d.kind} ${d.status}`} data-status={d.status}><div class="doc-code"><span>{d.kind}</span><strong>{d.status}</strong></div><div><h2><a href={d.demo?`/demo/${d.id}/`:`/documents/${d.id}/`}>{d.title}</a></h2><p>{d.summary}</p></div><div class="doc-check"><span>Проверено</span><strong>{d.checked}</strong></div></article>)}</div>{!docs.length&&<div class="clean-empty"><h2>Каталог пуст</h2><p>Добавьте первую карточку документа — интерфейс уже готов.</p></div>}</section><script>const q=document.querySelector('#doc-q');const s=document.querySelector('#doc-status');const cards=[...document.querySelectorAll('[data-doc]')];const c=document.querySelector('#doc-count');function f(){let n=0;cards.forEach(x=>{const ok=(!q.value||x.dataset.search.toLowerCase().includes(q.value.toLowerCase()))&&(!s.value||x.dataset.status===s.value);x.hidden=!ok;if(ok)n++});c.textContent=n}q?.addEventListener('input',f);s?.addEventListener('change',f);</script></BaseLayout>
