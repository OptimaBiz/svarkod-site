---
import '../styles/global.css';
import { nav, utilityNav } from '../data/site';
import { demoEnabled } from '../demo-data';
const { title='СВАРКОД — Код сварочной отрасли', description='Отраслевое медиа и рабочая система знаний о сварке, промышленной безопасности и регулировании.', noindex=false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const formsEndpoint = import.meta.env.PUBLIC_FORMS_ENDPOINT?.trim() || '';
---
<!doctype html><html lang="ru"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><meta name="robots" content={noindex?'noindex,nofollow':'index,follow'}/><link rel="canonical" href={canonical}/><link rel="alternate" type="application/rss+xml" title="СВАРКОД" href="/feed.xml"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={canonical}/><meta name="theme-color" content="#f5f2eb"/><title>{title}</title></head><body>
<a class="skip" href="#content">К содержанию</a>
{demoEnabled && <div class="demo-ribbon"><span>ДЕМО-РЕЖИМ</span><span>Вымышленные материалы для демонстрации интерфейса</span><code>pnpm demo:clean</code></div>}
<header class="masthead">
  <div class="masthead-top shell"><div class="masthead-date">11 августа 2026 <span>Москва</span></div><a class="wordmark" href="/">СВАРКОД<small>код сварочной отрасли</small></a><div class="masthead-tools"><a href="/search/" aria-label="Поиск">⌕ <span>Поиск</span></a><a class="join" href="/forum/">Форум</a></div></div>
  <nav class="editorial-nav" aria-label="Основная навигация"><div class="shell">{nav.map(item=><a class={Astro.url.pathname.startsWith(item.href)?'active':''} href={item.href}>{item.label}</a>)}<a href="/forum/">Форум</a></div></nav>
  <div class="topic-strip"><div class="shell"><strong>Сейчас:</strong><a href="/norms/">Регулирование ОПО</a><a href="/technologies/">Роботизация</a><a href="/practice/">Контроль качества</a><a href="/ratings/">Рейтинги</a></div></div>
</header>
<main id="content"><slot/></main>
<section class="newsletter"><div class="shell newsletter-inner"><div><span class="kicker inverse">РАССЫЛКИ</span><h2>Главное для тех, кто отвечает за результат</h2><p>Раз в неделю — нормы, практика, технологии и важные изменения без информационного шума.</p></div><form action={formsEndpoint || undefined} method="post"><input type="email" name="email" placeholder="name@company.ru" disabled={!formsEndpoint}/><button disabled={!formsEndpoint}>Подписаться</button><small>{formsEndpoint?'Нажимая кнопку, вы соглашаетесь с политикой обработки данных.':'Подписка включится после подключения защищённого обработчика.'}</small></form></div></section>
<footer class="site-footer"><div class="shell footer-top"><a class="wordmark footer-wordmark" href="/">СВАРКОД</a><p>Независимое отраслевое медиа и рабочая система знаний.</p></div><div class="shell footer-links"><div><strong>Редакция</strong>{nav.slice(0,5).map(i=><a href={i.href}>{i.label}</a>)}</div><div><strong>Система</strong>{nav.slice(5).map(i=><a href={i.href}>{i.label}</a>)}<a href="/forum/">Форум</a></div><div><strong>Проект</strong>{utilityNav.map(i=><a href={i.href}>{i.label}</a>)}<a href="/privacy/">Обработка данных</a></div><div><strong>Контакты</strong><a href="mailto:editor@svarkod.ru">editor@svarkod.ru</a><a href="mailto:ads@svarkod.ru">ads@svarkod.ru</a></div></div><div class="shell copyright">© 2026 СВАРКОД <span>Первоисточник имеет приоритет</span></div></footer>
</body></html>
