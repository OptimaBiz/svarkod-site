---
import BaseLayout from '../../layouts/BaseLayout.astro'; import {demoEvents} from '../../demo-data';
---
<BaseLayout title="События — СВАРКОД"><header class="section-hero shell"><span class="kicker">КАЛЕНДАРЬ</span><h1>События</h1><p>Выставки, конференции, обучение и нормативные даты — в одной временной шкале.</p></header><section class="shell timeline">{demoEvents.map(e=><article><time><strong>{e.day}</strong><span>{e.month}</span></time><div><span class="event-type">{e.type}</span><h2>{e.title}</h2><p>{e.desc}</p><small>{e.place}</small></div><span class="event-arrow">→</span></article>)}{!demoEvents.length&&<div class="clean-empty"><h2>Календарь пуст</h2><p>Добавьте первое проверенное событие или нормативную дату.</p></div>}</section></BaseLayout>
