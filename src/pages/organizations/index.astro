---
import BaseLayout from '../../layouts/BaseLayout.astro'; import {demoOrganizations} from '../../demo-data';
const orgs=demoOrganizations;
---
<BaseLayout title="Организации — СВАРКОД"><header class="section-hero shell"><span class="kicker">СПРАВОЧНИК</span><h1>Организации</h1><p>Не каталог рекламных ссылок, а структурированные профили с типом, регионом и прозрачным статусом данных.</p></header><section class="shell directory-shell"><div class="filter-bar"><input id="org-q" placeholder="Название, регион, специализация"/><select id="org-type"><option value="">Все типы</option>{[...new Set(orgs.map(o=>o.type))].map(t=><option>{t}</option>)}</select><span><strong id="org-count">{orgs.length}</strong> профилей</span></div><div class="org-grid">{orgs.map(o=><article data-org data-search={`${o.name} ${o.region} ${o.type}`} data-type={o.type}><div class="org-top"><span>{o.type}</span><span class="verified">● Проверено</span></div><h2>{o.name}</h2><p>{o.region}</p><div class="org-bottom"><strong>{o.rating}</strong><span>{o.meta}</span></div></article>)}</div>{!orgs.length&&<div class="clean-empty"><h2>Справочник пуст</h2><p>Добавьте проверенные профили организаций. Фильтры и карточки уже готовы.</p></div>}</section><script>const q=document.querySelector('#org-q');const s=document.querySelector('#org-type');const cards=[...document.querySelectorAll('[data-org]')];const c=document.querySelector('#org-count');function f(){let n=0;cards.forEach(x=>{const ok=(!q.value||x.dataset.search.toLowerCase().includes(q.value.toLowerCase()))&&(!s.value||x.dataset.type===s.value);x.hidden=!ok;if(ok)n++});c.textContent=n}q?.addEventListener('input',f);s?.addEventListener('change',f);</script></BaseLayout>
