---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { demoArticles, demoDocuments, demoEvents, demoForum, demoOrganizations, demoRatings, demoEnabled } from '../demo-data';
import { sortArticles, toArticleCard } from '../lib/content';
const real = sortArticles(await getCollection('articles', ({data})=>!data.draft)).map(a=>({...toArticleCard(a), demo:false}));
const demo = demoArticles.map(a=>({...a,demo:true}));
const stories = demoEnabled ? demo : real;
const lead = stories[0];
const side = stories.slice(1,4);
const latest = stories.slice(4,10);
---
<BaseLayout>
<section class="front shell">
  <div class="front-grid">
    <div class="front-lead">{lead && <ArticleCard article={lead} lead/>}</div>
    <div class="front-side">{side.map(a=><ArticleCard article={a} compact/>)}</div>
    <aside class="front-brief"><div class="brief-head"><span>Коротко</span><time>18:14</time></div>{stories.slice(10,15).map(a=><a href={a.demo?`/demo/${a.slug}/`:`/articles/${a.slug}/`}><strong>{a.title}</strong><span>{a.section}</span></a>)}</aside>
  </div>
  <div class="front-divider"></div>
  <div class="front-heading"><span class="kicker">ПОСЛЕДНЕЕ</span><h2>Что важно знать сегодня</h2><a href="/news/">Все материалы →</a></div>
  <div class="story-grid">{latest.map(a=><ArticleCard article={a}/>)}</div>
</section>

<section class="section-paper"><div class="shell"><div class="front-heading"><span class="kicker">НОРМЫ</span><h2>Регулирование без пересказов</h2><a href="/norms/">Открыть раздел →</a></div><div class="feature-row">{stories.filter(a=>a.section==='Нормы').slice(0,3).map((a,i)=><ArticleCard article={a} lead={i===0}/>)}</div></div></section>

<section class="workbench shell"><div class="workbench-head"><span class="kicker">РАБОЧИЙ СТОЛ</span><h2>Не только читать — проверять</h2><p>Документы, организации, события и рейтинги связаны с редакционными материалами.</p></div><div class="workbench-grid"><a class="tool-card" href="/documents/"><span>01</span><h3>Документы</h3><strong>{demoDocuments.length || '—'}</strong><p>карточек в демо</p></a><a class="tool-card" href="/organizations/"><span>02</span><h3>Организации</h3><strong>{demoOrganizations.length || '—'}</strong><p>проверяемых профилей</p></a><a class="tool-card" href="/events/"><span>03</span><h3>Календарь</h3><strong>{demoEvents.length || '—'}</strong><p>ближайших событий</p></a><a class="tool-card" href="/ratings/"><span>04</span><h3>Рейтинги</h3><strong>{demoRatings.length || '—'}</strong><p>демо-позиций</p></a></div></section>

<section class="forum-teaser"><div class="shell"><div class="front-heading inverse-heading"><span class="kicker inverse">ФОРУМ</span><h2>Профессиональный разговор</h2><a href="/forum/">Все обсуждения →</a></div><div class="forum-mini">{demoForum.slice(0,4).map(t=><a href="/forum/"><span>{t.tag}</span><strong>{t.title}</strong><small>{t.replies} ответов · {t.last}</small></a>)}</div></div></section>
</BaseLayout>
