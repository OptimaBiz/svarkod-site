---
import '../styles/global.css';
import '../styles/platform.css';
import { nav } from '../data/site';
const { title = 'СВАРКОД — Код сварочной отрасли', description = 'Независимое отраслевое интернет-издание о технологиях сварки, промышленной безопасности и нормативном регулировании.', ogType = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const currentPath = Astro.url.pathname;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#08151d" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content={ogType} /><meta property="og:url" content={canonical} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#content">К содержанию</a>
    <header class="site-header">
      <div class="utility"><div class="shell utility-inner"><span><i></i> Независимое отраслевое издание</span><div><a href="/advertising/">Реклама и партнёрство</a><a href="mailto:editor@svarkod.ru">Связаться с редакцией</a></div></div></div>
      <div class="shell masthead">
        <a class="brand" href="/" aria-label="СВАРКОД — на главную"><span>СВАР</span><b>КОД</b><small>Код сварочной отрасли</small></a>
        <div class="masthead-statement"><span>Технологии сварки</span><span>Промышленная безопасность</span><span>Регулирование</span></div>
        <div class="header-actions"><a class="icon-button" href="/search/" aria-label="Глобальный поиск"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.6"></circle><path d="m16 16 5 5"></path></svg></a><a class="button button-small" href="#subscribe">Подписаться <span>↗</span></a></div>
      </div>
      <nav class="main-nav" aria-label="Основная навигация"><div class="shell nav-inner">{nav.map(item => <a class={currentPath.startsWith(item.href) ? 'active' : ''} href={item.href}>{item.label}</a>)}<a class="forum" href="https://forum.svarkod.ru">Форум <span>↗</span></a><span class="nav-status"><i></i>В работе с 2026</span></div></nav>
    </header>
    <main id="content"><slot /></main>
    <section class="subscribe" id="subscribe"><div class="shell subscribe-grid"><div><p class="kicker on-dark">Письмо редакции</p><h2>Важное — в вашей рабочей почте</h2><p>Раз в неделю: новые нормы, технология, практика и материалы, которые стоит сохранить.</p></div><form action="#" method="post"><label class="sr-only" for="email">Рабочая почта</label><div class="subscribe-field"><input id="email" type="email" placeholder="name@company.ru" required /><button class="button light-button">Подписаться <span>→</span></button></div><small>Без спама. Можно отписаться в один клик.</small></form></div></section>
    <footer><div class="shell footer-grid"><div><a class="brand footer-brand" href="/"><span>СВАР</span><b>КОД</b><small>Код сварочной отрасли</small></a><p>Независимое медиа о сварке на ОПО, технологиях, промышленной безопасности и регулировании.</p></div><div><h3>Навигация</h3>{nav.map(item => <a href={item.href}>{item.label}</a>)}<a href="/search/">Поиск</a></div><div><h3>Проект</h3><a href="/about/">О СВАРКОД</a><a href="/advertising/">Реклама</a><a href="https://forum.svarkod.ru">Форум ↗</a><a href="mailto:editor@svarkod.ru">Редакция</a></div><div class="footer-mark"><span>СВ</span><p>Делаем сложное<br/>понятным.</p></div></div><div class="shell legal"><span>© 2026 СВАРКОД</span><span>Материалы носят информационный характер</span><span>Россия · Весь мир</span></div></footer>
  </body>
</html>
