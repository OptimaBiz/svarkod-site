---
const { article, large = false } = Astro.props;
const visualClass = article.section.toLowerCase().replaceAll(' ', '-');
const href = article.href ?? `/articles/${article.slug}/`;
---
<article class:list={['article-card', `visual-${visualClass}`, { large }]}>
  <a class="article-visual" href={href} aria-label={article.title} style={article.image ? `background-image:linear-gradient(90deg, rgba(7,22,30,.15), rgba(7,22,30,.05)),url('${article.image}')` : undefined}><span>{article.section}</span><b aria-hidden="true">↗</b></a>
  <div class="article-body"><div class="meta"><span>{article.section}</span><span>{article.date}</span><span>{article.read}</span></div><h3><a href={href}>{article.title}</a></h3><p>{article.lead}</p><a class="read-more" href={href}>Открыть раздел <span>→</span></a></div>
</article>
