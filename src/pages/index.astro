---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { articles } from '../data/site';
---
<BaseLayout>
  <section class="hero-premium">
    <div class="hero-image" role="img" aria-label="Специалист выполняет сварочные работы на промышленном трубопроводе"></div>
    <div class="shell hero-premium-inner"><div class="hero-copy"><p class="kicker on-dark"><i></i> Сварка на ОПО</p><h1>Сложное<br/><em>становится ясным.</em></h1><p>СВАРКОД — независимое медиа о технологиях сварки, промышленной безопасности и регулировании.</p><div class="hero-actions"><a class="button" href="/requirements/">Изучить нормы <span>→</span></a><a class="hero-text-link" href="/practice/">Перейти к практике <span>↗</span></a></div></div><div class="hero-signal"><span class="signal-number">01 / 26</span><div><p>В центре внимания</p><h2>Когда требование становится действием</h2><a href="/requirements/">Открыть нормативный навигатор <span>→</span></a></div></div></div>
    <div class="hero-rail"><div class="shell"><span>Нормативный навигатор</span><span>Технологический обзор</span><span>Контроль качества</span><span>Экспертное сообщество</span></div></div>
  </section>
  <section class="briefing"><div class="shell briefing-grid"><div class="briefing-label"><span class="live-dot"></span><b>Редакционный радар</b><small>СВАРКОД 3.0</small></div><a href="/requirements/">Нормативные документы, требования и переходные положения — в единой системе связей</a><a class="arrow-link" href="/requirements/" aria-label="Открыть требования">→</a></div></section>
  <section class="shell section-block editorial-block"><div class="section-head"><div><p class="kicker">Выбор редакции</p><h2>Не пропустить важное</h2></div><p class="section-intro">Материалы, где за изменением в отрасли виден его смысл для специалиста и производства.</p></div><div class="lead-grid"><ArticleCard article={articles[0]} large /><div class="side-list">{articles.slice(1,4).map(article => <ArticleCard article={article} />)}</div></div></section>
  <section class="system-section"><div class="shell"><div class="section-head inverse"><div><p class="kicker on-dark">Рабочая система знаний</p><h2>От документа<br/>до решения</h2></div><p>СВАРКОД соединяет норму, технологию и профессиональный опыт. Так информация становится инструментом, а не шумом.</p></div><div class="path-grid"><a href="/norms/"><span class="path-icon">01</span><div><h3>Нормы</h3><p>Действующие документы, изменения и ясные разъяснения.</p></div><b>Открыть <i>→</i></b></a><a href="/practice/"><span class="path-icon">02</span><div><h3>Практика</h3><p>Технологии, контроль, аттестация и опыт производств.</p></div><b>Открыть <i>→</i></b></a><a href="/services/"><span class="path-icon">03</span><div><h3>Услуги</h3><p>Контент и экспертная коммуникация для B2B-компаний.</p></div><b>Открыть <i>→</i></b></a></div></div></section>
  <section class="shell section-block intelligence"><div class="intelligence-mark"><span>СВ</span><i></i><i></i><i></i></div><div><p class="kicker">Индекс доверия</p><h2>Рейтинги с проверяемой методикой</h2><p>Открытые критерии, верификация, редакционный контроль и чёткое разделение оценки и рекламы.</p><a class="text-link" href="/ratings/methodology/">Как устроены рейтинги <span>→</span></a></div><div class="index-stats"><div><strong>01</strong><span>методика публикуется<br/>до расчёта</span></div><div><strong>02</strong><span>реклама не влияет<br/>на место</span></div></div></section>
  <section class="shell section-block compact-news"><div class="section-head"><div><p class="kicker">На горизонте</p><h2>Следить за отраслью</h2></div><a class="text-link" href="/news/">Все новости <span>→</span></a></div><div class="horizon-grid"><a href="/news/"><span>01</span><p>Рынок и люди</p><h3>Решения, компании и истории, которые формируют отрасль</h3><b>Новости →</b></a><a href="/practice/"><span>02</span><p>Технологии</p><h3>Процессы и инструменты, которые повышают предсказуемость работ</h3><b>Практика →</b></a><a href="https://forum.svarkod.ru"><span>03</span><p>Сообщество</p><h3>Профессиональный разговор без случайного информационного шума</h3><b>Перейти на форум ↗</b></a></div></section>
</BaseLayout>
