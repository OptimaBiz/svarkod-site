---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { formatDate, sortArticles, toArticleCard } from '../lib/content';

const articleEntries = sortArticles(await getCollection('articles', ({ data }) => !data.draft));
const articles = articleEntries.map(toArticleCard);
const documents = (await getCollection('documents', ({ data }) => !data.draft)).sort((a, b) => b.data.updatedAt.getTime() - a.data.updatedAt.getTime());
const organizations = await getCollection('organizations', ({ data }) => !data.draft && data.verification === 'Проверено редакцией');
const events = (await getCollection('events', ({ data }) => !data.draft && data.verification === 'Проверено редакцией')).sort((a, b) => a.data.startsAt.getTime() - b.data.startsAt.getTime());
const latestNorm = articleEntries.find(entry => entry.data.section === 'Нормы');
const latestPractice = articleEntries.find(entry => entry.data.section === 'Практика');
const latestTechnology = articleEntries.find(entry => entry.data.section === 'Технологии');
const nextEvent = events[0];
---
<BaseLayout>
  <section class="hero shell hero-v2">
    <div class="hero-copy"><p class="eyebrow">СВАРКОД 2.0 · рабочая система отрасли</p><h1>Не просто читать.<br/><em>Находить и проверять.</em></h1><p class="hero-lead">Материалы, документы, организации, рейтинги и отраслевой календарь связаны в одной системе поиска и навигации.</p><form class="command-search" action="/search/" method="get"><label class="sr-only" for="hero-q">Поиск по СВАРКОД</label><input id="hero-q" name="q" type="search" placeholder="Например: контроль сварных соединений"/><button class="button" type="submit">Найти в системе</button></form><div class="quick-links"><a href="/documents/">Документы</a><a href="/organizations/">Организации</a><a href="/events/">Календарь</a><a href="/ratings/">Рейтинги</a></div></div>
    <aside class="issue system-panel"><span class="issue-num">2.0</span><p>Рабочая панель</p><h2>От вопроса к проверяемому источнику</h2><ul><li><a href="/norms/"><strong>Нормы</strong><span>{latestNorm ? latestNorm.data.title : 'Редакционные разборы требований'}</span></a></li><li><a href="/documents/"><strong>Документы</strong><span>{documents.length} проверенных редакционных карточек</span></a></li><li><a href="/organizations/"><strong>Организации</strong><span>{organizations.length ? `${organizations.length} проверенных профилей` : 'Каталог готов к проверяемому наполнению'}</span></a></li><li><a href="/events/"><strong>События</strong><span>{nextEvent ? `${formatDate(nextEvent.data.startsAt)} · ${nextEvent.data.title}` : 'Публикуются только после проверки источника'}</span></a></li></ul></aside>
  </section>
  <section class="ticker"><div class="shell"><strong>Система 2.0</strong><span class="ticker-copy">Контент → первоисточник → организация → событие → рейтинг → обсуждение</span><a href="/about/">Как устроен СВАРКОД →</a></div></section>

  <section class="shell section-block"><div class="section-head"><div><p class="eyebrow">Сейчас важно</p><h2>Рабочий обзор</h2></div><a class="text-link" href="/search/">Поиск по всей системе →</a></div><div class="ops-grid"><a class="ops-card" href={latestNorm ? `/articles/${latestNorm.id}/` : '/norms/'}><span>Нормы</span><h3>{latestNorm?.data.title ?? 'Нормативные разборы'}</h3><p>{latestNorm?.data.lead ?? 'Изменения требований с переходом к первоисточнику.'}</p><b>Открыть →</b></a><a class="ops-card" href="/documents/"><span>Документы</span><h3>Каталог с редакционным статусом</h3><p>Дата проверки, тип материала, связанный разбор и приоритет официального источника.</p><b>Найти документ →</b></a><a class="ops-card" href="/organizations/"><span>Организации</span><h3>Единая карточка отраслевой организации</h3><p>Тип, регион, статус проверки, связанные материалы и будущая рейтинговая история.</p><b>Открыть каталог →</b></a><a class="ops-card" href="/events/"><span>Календарь</span><h3>События и нормативные даты</h3><p>Выставки, обучение, вебинары и даты вступления требований в силу — только после проверки.</p><b>Открыть календарь →</b></a></div></section>

  <section class="shell section-block section-rule"><div class="section-head"><div><p class="eyebrow">Редакция</p><h2>Последние материалы</h2></div><a class="text-link" href="/news/">Все материалы →</a></div><div class="lead-grid">{articles[0] && <ArticleCard article={articles[0]} large />}<div class="side-list">{articles.slice(1,4).map(article => <ArticleCard article={article} />)}</div></div></section>

  <section class="dark-section"><div class="shell"><div class="section-head inverse"><div><p class="eyebrow light">Навигатор специалиста</p><h2>Шесть слоёв одной системы</h2></div><p>У каждой сущности свой интерфейс: редакционная статья не выглядит как нормативная карточка, а рейтинг не смешивается с рекламным профилем.</p></div><div class="pillar-grid six"><a href="/norms/"><span>01</span><h3>Нормы</h3><p>Что изменилось и кого касается.</p><b>Разобрать →</b></a><a href="/documents/"><span>02</span><h3>Документы</h3><p>Первоисточники и статус проверки.</p><b>Проверить →</b></a><a href="/practice/"><span>03</span><h3>Практика</h3><p>Контроль, процессы и применение.</p><b>Применить →</b></a><a href="/technologies/"><span>04</span><h3>Технологии</h3><p>Оборудование и инженерная оценка.</p><b>Сравнить →</b></a><a href="/organizations/"><span>05</span><h3>Организации</h3><p>Проверяемые отраслевые профили.</p><b>Найти →</b></a><a href="/ratings/"><span>06</span><h3>Рейтинги</h3><p>Методика, верификация, история.</p><b>Оценить →</b></a></div></div></section>

  <section class="shell section-block split-feature"><div><p class="eyebrow">База знаний</p><h2>Документы не прячутся внутри новостей</h2><p>Каждая карточка существует отдельно: с типом, датой редакционной сверки, пояснением и связью с материалами.</p><div class="mini-list">{documents.slice(0,3).map(document => <a href={`/documents/${document.id}/`}><span>{document.data.status}</span><strong>{document.data.title}</strong><small>Проверено {formatDate(document.data.updatedAt)}</small></a>)}</div><a class="button" href="/documents/">Открыть документы</a></div><div class="database-card"><p class="eyebrow">Каталог организаций</p><h2>Профиль вместо случайной ссылки</h2><p>СРО, аттестационные и учебные центры, лаборатории, производители и поставщики будут собраны в общей структуре с отметкой проверки.</p><ul><li>Единая классификация</li><li>Регион и специализация</li><li>Связанные материалы и документы</li><li>Рейтинг отделён от коммерческого профиля</li></ul><a class="text-link" href="/organizations/">Перейти в каталог →</a></div></section>

  <section class="shell section-block section-rule"><div class="section-head"><div><p class="eyebrow">Практика и технологии</p><h2>От процесса к инженерному решению</h2></div></div><div class="cards-grid two">{latestPractice && <a class="feature-card" href={`/articles/${latestPractice.id}/`}><span>Практика</span><h3>{latestPractice.data.title}</h3><p>{latestPractice.data.lead}</p><b>Читать →</b></a>}{latestTechnology && <a class="feature-card" href={`/articles/${latestTechnology.id}/`}><span>Технологии</span><h3>{latestTechnology.data.title}</h3><p>{latestTechnology.data.lead}</p><b>Читать →</b></a>}{!latestTechnology && <a class="feature-card" href="/technologies/"><span>Технологии</span><h3>Раздел готов к инженерным материалам</h3><p>Технологические публикации выделены в отдельную вертикаль и индекс поиска.</p><b>Открыть →</b></a>}</div></section>

  <section class="calendar-band"><div class="shell calendar-grid"><div><p class="eyebrow light">Отраслевой календарь</p><h2>{nextEvent ? nextEvent.data.title : 'Непроверенные даты не публикуем ради наполнения'}</h2><p>{nextEvent ? `${formatDate(nextEvent.data.startsAt)} · ${nextEvent.data.location}` : 'Система уже поддерживает выставки, конференции, вебинары, обучение и нормативные даты. Публичные записи появятся после редакционной проверки источников.'}</p></div><a class="button light-button" href="/events/">Открыть календарь</a></div></section>

  <section class="shell section-block"><div class="section-head"><div><p class="eyebrow">Доверие отрасли</p><h2>Рейтинги СВАРКОД</h2></div><a class="text-link" href="/ratings/methodology/">Методика →</a></div><div class="rating-feature"><div><span class="rating-label">Сначала правила — потом места</span><h3>Рейтинг как проверяемый информационный продукт</h3><p>Критерии, верификация участника, защита от аномалий, публичная история пересмотров и жёсткое разделение рекламы и результата.</p><a class="button" href="/ratings/">Статус запуска</a></div><div class="score"><strong>0</strong><span>публичных мест до утверждения методики</span><strong>5</strong><span>слоёв прозрачности заложено в систему</span></div></div></section>
</BaseLayout>
