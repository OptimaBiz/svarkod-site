---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { directoryTypes } from '../../data/site';
import { formatDate } from '../../lib/content';

const organizations = (await getCollection('organizations', ({ data }) => !data.draft)).sort((a, b) => a.data.name.localeCompare(b.data.name, 'ru'));
const regions = [...new Set(organizations.map(entry => entry.data.region))].sort((a, b) => a.localeCompare(b, 'ru'));
---
<BaseLayout title="Организации — СВАРКОД" description="Проверяемый каталог СРО, аттестационных и учебных центров, лабораторий, производителей, поставщиков и экспертных организаций.">
  <header class="page-hero shell"><p class="eyebrow">Отраслевой справочник</p><h1>Организации</h1><p>Единые карточки организаций с типом, регионом, редакционным статусом и связями с материалами, документами и будущими рейтингами.</p></header>
  <section class="directory-tools shell"><label class="directory-search"><span>Поиск</span><input id="org-query" type="search" placeholder="Название, регион, специализация…" /></label><label><span>Тип</span><select id="org-type"><option value="">Все типы</option>{directoryTypes.map(type => <option value={type}>{type}</option>)}</select></label><label><span>Регион</span><select id="org-region"><option value="">Все регионы</option>{regions.map(region => <option value={region}>{region}</option>)}</select></label><div class="directory-count"><strong id="org-count">{organizations.length}</strong><span>карточек</span></div></section>
  <section class="shell section-block compact"><div class="directory-grid" id="org-results">{organizations.map(entry => <article class="entity-card" data-org-card data-type={entry.data.type} data-region={entry.data.region} data-search={`${entry.data.name} ${entry.data.shortName ?? ''} ${entry.data.description} ${entry.data.type} ${entry.data.region} ${entry.data.city ?? ''} ${entry.data.tags.join(' ')}`}><div class="entity-top"><span>{entry.data.type}</span><span class:list={['verification', { verified: entry.data.verification === 'Проверено редакцией' }]}>{entry.data.verification}</span></div><h2><a href={`/organizations/${entry.id}/`}>{entry.data.name}</a></h2><p>{entry.data.description}</p><div class="entity-meta"><span>{entry.data.city ? `${entry.data.city} · ` : ''}{entry.data.region}</span>{entry.data.verifiedAt && <span>Проверено {formatDate(entry.data.verifiedAt)}</span>}</div><a class="text-link" href={`/organizations/${entry.id}/`}>Открыть профиль →</a></article>)}</div>{!organizations.length && <div class="empty-state directory-empty"><span>Каталог готов к наполнению</span><h2>Публичных карточек пока нет</h2><p>Мы не создаём фиктивные компании ради демонстрации интерфейса. Первая карточка появится после проверки источников и принадлежности данных.</p><a class="button" href="/documents/organization-card-method/">Как проверяется карточка</a></div>}<div id="org-empty-filter" class="empty-state hidden"><span>Фильтр</span><h2>Совпадений нет</h2><p>Измените запрос, тип или регион.</p></div></section>
  <section class="dark-section directory-principles"><div class="shell"><div class="section-head inverse"><div><p class="eyebrow light">Архитектура справочника</p><h2>Профиль — самостоятельная отраслeвая сущность</h2></div><p>Он не зависит от рекламного размещения и может связываться с редакционными материалами, документами, событиями и рейтингом.</p></div><div class="pillar-grid four">{directoryTypes.slice(0,4).map((type, index) => <div><span>0{index + 1}</span><h3>{type}</h3><p>Единый формат данных и статус редакционной проверки.</p></div>)}</div></div></section>
  <script>
    const query = document.querySelector('#org-query');
    const type = document.querySelector('#org-type');
    const region = document.querySelector('#org-region');
    const cards = [...document.querySelectorAll('[data-org-card]')];
    const count = document.querySelector('#org-count');
    const empty = document.querySelector('#org-empty-filter');
    const normalize = (value) => String(value || '').toLocaleLowerCase('ru-RU').replace(/ё/g, 'е').trim();
    function filterDirectory() {
      const q = normalize(query?.value);
      const selectedType = type?.value || '';
      const selectedRegion = region?.value || '';
      let visible = 0;
      cards.forEach((card) => {
        const matchesQuery = !q || normalize(card.dataset.search).includes(q);
        const matchesType = !selectedType || card.dataset.type === selectedType;
        const matchesRegion = !selectedRegion || card.dataset.region === selectedRegion;
        const show = matchesQuery && matchesType && matchesRegion;
        card.hidden = !show;
        if (show) visible += 1;
      });
      if (count) count.textContent = String(visible);
      if (empty) empty.classList.toggle('hidden', visible !== 0 || cards.length === 0);
    }
    query?.addEventListener('input', filterDirectory);
    type?.addEventListener('change', filterDirectory);
    region?.addEventListener('change', filterDirectory);
  </script>
</BaseLayout>
