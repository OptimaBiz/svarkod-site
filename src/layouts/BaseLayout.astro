---
import '../styles/global.css';
import '../styles/platform.css';
import { primaryNav, utilityNav } from '../data/site';
const {title='СВАРКОД — сварка, аттестация и промышленная безопасность',description='Отраслевое сетевое издание и рабочая система знаний о сварке, аттестации и промышленной безопасности.',noindex=false,ogType='website',pageStructuredData}=Astro.props;
const canonical=new URL(Astro.url.pathname,Astro.site);const formsEndpoint=import.meta.env.PUBLIC_FORMS_ENDPOINT?.trim()||'';const today=new Intl.DateTimeFormat('ru-RU',{day:'numeric',month:'long',year:'numeric',timeZone:'Europe/Moscow'}).format(new Date());const structured=pageStructuredData?JSON.stringify(pageStructuredData).replace(/</g,'\\u003c'):'';
---
<!doctype html><html lang="ru"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><meta name="robots" content={noindex?'noindex,nofollow':'index,follow'}/><link rel="canonical" href={canonical}/><link rel="alternate" type="application/rss+xml" title="СВАРКОД" href="/feed.xml"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content={ogType}/><meta property="og:url" content={canonical}/><meta name="theme-color" content="#f5f2eb"/><title>{title}</title>{structured&&<script type="application/ld+json" set:html={structured}></script>}</head><body><a class="skip" href="#content">К содержанию</a><header class="masthead"><div class="masthead-top shell"><div class="masthead-date">{today}<span>Москва</span></div><a class="wordmark" href="/">СВАРКОД<small>код сварочной отрасли</small></a><div class="masthead-tools"><a href="/search/">⌕ <span>Поиск</span></a><a class="join" href="/forum/">Форум</a></div></div><nav class="editorial-nav" aria-label="Основная навигация"><div class="shell">{primaryNav.map(item=><a class={Astro.url.pathname.startsWith(item.href)?'active':''} href={item.href}>{item.label}</a>)}</div></nav><div class="topic-strip"><div class="shell"><strong>Рабочие разделы:</strong><a href="/requirements/navigator/">Навигатор требований</a><a href="/certification/roadmaps/">Маршруты аттестации</a><a href="/registry/verify/">Проверка сведений</a><a href="/ratings/methodology/">Методика рейтингов</a></div></div></header><main id="content"><slot/></main><section class="newsletter"><div class="shell newsletter-inner"><div><span class="kicker inverse">РАССЫЛКА</span><h2>Изменения, которые требуют действия</h2><p>Нормы, аттестация, практика и важные отраслевые события с приоритетом первоисточника.</p></div><form action={formsEndpoint||undefined} method="post"><input type="email" name="email" placeholder="name@company.ru" disabled={!formsEndpoint}/><button disabled={!formsEndpoint}>Подписаться</button><small>{formsEndpoint?'Нажимая кнопку, вы соглашаетесь с политикой обработки данных.':'Подписка включится после подключения защищённого обработчика.'}</small></form></div></section><footer class="site-footer"><div class="shell footer-top"><a class="wordmark footer-wordmark" href="/">СВАРКОД</a><p>Независимое отраслевое издание и рабочая система знаний.</p></div><div class="shell footer-links"><div><strong>Система</strong>{primaryNav.slice(0,3).map(i=><a href={i.href}>{i.label}</a>)}</div><div><strong>Данные</strong>{primaryNav.slice(3).map(i=><a href={i.href}>{i.label}</a>)}</div><div><strong>Проект</strong>{utilityNav.map(i=><a href={i.href}>{i.label}</a>)}<a href="/about/editorial-policy/">Редакционная политика</a><a href="/about/corrections/">Исправления</a><a href="/privacy/">Обработка данных</a></div><div><strong>Контакты</strong><a href="mailto:editor@svarkod.ru">editor@svarkod.ru</a><a href="mailto:ads@svarkod.ru">ads@svarkod.ru</a></div></div><div class="shell copyright">© 2026 СВАРКОД <span>Официальный первоисточник имеет приоритет</span></div></footer></body></html>
