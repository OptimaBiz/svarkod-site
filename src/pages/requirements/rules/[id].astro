---
import { getCollection, render } from 'astro:content'; import BaseLayout from '../../../layouts/BaseLayout.astro'; import { formatDate } from '../../../lib/content';
export async function getStaticPaths(){const items=await getCollection('requirements',({data})=>!data.draft);return items.map(item=>({params:{id:item.id},props:{item}}));}
const {item}=Astro.props; const {Content}=await render(item);
const schema={'@context':'https://schema.org','@type':'TechArticle',headline:item.data.title,description:item.data.summary,dateModified:item.data.reviewedAt.toISOString()};
---
<BaseLayout title={`${item.data.title} — Требования — СВАРКОД`} description={item.data.summary} pageStructuredData={schema}><article class="entity-page"><header class="entity-hero shell"><div class="entity-kicker"><span>ТРЕБОВАНИЕ</span><span class="verification verified">Проверено {formatDate(item.data.reviewedAt)}</span></div><h1>{item.data.title}</h1><p>{item.data.summary}</p><div class="entity-facts"><div><span>Кому</span><strong>{item.data.subject}</strong></div><div><span>Что сделать</span><strong>{item.data.obligation}</strong></div><div><span>Источник</span><strong>{item.data.sourceSection||'см. карточку документа'}</strong></div></div></header><div class="article-content shell"><aside><strong>Применимость</strong>{item.data.roles.map(x=><span>{x}</span>)}</aside><div><Content/>{item.data.evidenceRequired.length>0&&<><h2>Чем подтверждается</h2><ul>{item.data.evidenceRequired.map(x=><li>{x}</li>)}</ul></>}<div class="note"><strong>Важно</strong><p>Перед практическим решением проверьте официальный источник, редакцию документа и область применения.</p></div></div></div></article></BaseLayout>
