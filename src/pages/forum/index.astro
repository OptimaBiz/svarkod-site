---
import BaseLayout from '../../layouts/BaseLayout.astro'; import {demoForum} from '../../demo-data';
---
<BaseLayout title="Форум — СВАРКОД"><header class="forum-header"><div class="shell"><span class="kicker inverse">СООБЩЕСТВО</span><h1>Форум</h1><p>Обсуждения специалистов — от нормативных вопросов до настройки оборудования.</p><div class="forum-stats"><span><strong>{demoForum.length}</strong> активных тем</span><span><strong>286</strong> ответов</span><span><strong>28k</strong> просмотров</span></div></div></header><section class="shell forum-layout"><aside class="forum-cats"><strong>Разделы</strong>{['Все темы','Нормы','Практика','Оборудование','Контроль','Материалы','Автоматизация','Карьера'].map((x,i)=><button class={i===0?'active':''}>{x}</button>)}</aside><div class="forum-stream"><div class="forum-stream-head"><h2>Свежие обсуждения</h2><button>+ Новая тема</button></div>{demoForum.map(t=><article><div class="forum-avatar">{t.author.slice(0,1)}</div><div><span>{t.tag}</span><h3>{t.title}</h3><small>{t.author} · {t.last}</small></div><div class="forum-numbers"><strong>{t.replies}</strong><span>ответов</span></div><div class="forum-numbers"><strong>{t.views}</strong><span>просмотров</span></div></article>)}{!demoForum.length&&<div class="clean-empty"><h2>Форум пуст</h2><p>Оболочка сообщества сохранена. Подключите отдельный форумный контур или добавьте первые темы.</p></div>}</div></section></BaseLayout>
