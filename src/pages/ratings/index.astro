---
import {getCollection} from 'astro:content'; import BaseLayout from '../../layouts/BaseLayout.astro'; import {formatDate} from '../../lib/content';
const editions=(await getCollection('ratingEditions',({data})=>!data.draft)).sort((a,b)=>b.data.cutoffAt.getTime()-a.data.cutoffAt.getTime());
---
<BaseLayout title="Рейтинги — СВАРКОД"><header class="section-hero shell"><span class="kicker">ДАННЫЕ И ДОВЕРИЕ</span><h1>Рейтинги</h1><p>Рейтинг существует только как версионируемый выпуск с методикой, датой среза, набором данных и процедурой апелляций.</p></header><section class="shell ratings-wrap"><div class="ratings-actions"><a href="/ratings/methodology/">Методика →</a><a href="/ratings/data-sources/">Источники →</a><a href="/ratings/appeals/">Апелляции →</a><a href="/ratings/audit-log/">Журнал →</a></div>{editions.map(e=><article class="rating-edition"><span>{e.data.status}</span><h2>{e.data.title}</h2><p>{e.data.period}</p><dl><div><dt>Срез</dt><dd>{formatDate(e.data.cutoffAt)}</dd></div><div><dt>Методика</dt><dd>{e.data.methodologyVersion}</dd></div><div><dt>Данные</dt><dd>{e.data.datasetVersion}</dd></div></dl></article>)}{!editions.length&&<div class="clean-empty"><h2>Реальные места пока не опубликованы</h2><p>Сначала утверждаются критерии, источники, антифрод, апелляции и неизменяемая версия выпуска.</p></div>}</section></BaseLayout>
