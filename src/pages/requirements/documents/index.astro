---
import { getCollection } from 'astro:content'; import BaseLayout from '../../../layouts/BaseLayout.astro'; import { formatDate } from '../../../lib/content';
const docs=(await getCollection('documents',({data})=>!data.draft)).sort((a,b)=>b.data.updatedAt.getTime()-a.data.updatedAt.getTime());
---
<BaseLayout title="Документы и первоисточники — СВАРКОД"><header class="section-hero shell"><span class="kicker">ТРЕБОВАНИЯ</span><h1>Документы</h1><p>Карточки первоисточников и редакционных методик: статус, реквизиты, дата действия и последняя сверка.</p></header><section class="shell directory-shell"><div class="filter-bar"><input id="doc-q" placeholder="Название, номер, орган или тип"/><select id="doc-status"><option value="">Все статусы</option>{[...new Set(docs.map(d=>d.data.status))].map(x=><option>{x}</option>)}</select><span><strong id="doc-count">{docs.length}</strong> карточек</span></div><div class="document-table">{docs.map(d=><article data-doc data-search={`${d.data.title} ${d.data.number||''} ${d.data.issuer||''} ${d.data.category}`} data-status={d.data.status}><div class="doc-code"><span>{d.data.documentType||d.data.category}</span><strong>{d.data.status}</strong></div><div><h2><a href={`/documents/${d.id}/`}>{d.data.title}</a></h2><p>{d.data.description}</p>{d.data.officialUrl&&<a rel="nofollow noopener" target="_blank" href={d.data.officialUrl}>Официальный источник ↗</a>}</div><div class="doc-check"><span>Сверено</span><strong>{formatDate(d.data.verifiedAt||d.data.updatedAt)}</strong></div></article>)}</div>{!docs.length&&<div class="clean-empty"><h2>Проверенных карточек пока нет</h2><p>СВАРКОД не заполняет нормативную базу вымышленными документами.</p></div>}</section><script>const q=document.querySelector('#doc-q');const s=document.querySelector('#doc-status');const cards=[...document.querySelectorAll('[data-doc]')];const c=document.querySelector('#doc-count');function f(){let n=0;cards.forEach(x=>{const ok=(!q.value||x.dataset.search.toLowerCase().includes(q.value.toLowerCase()))&&(!s.value||x.dataset.status===s.value);x.hidden=!ok;if(ok)n++});c.textContent=String(n)}q?.addEventListener('input',f);s?.addEventListener('change',f);</script></BaseLayout>
