---
import {getCollection,render} from 'astro:content'; import BaseLayout from '../../../layouts/BaseLayout.astro'; import {formatDate} from '../../../lib/content';
export async function getStaticPaths(){const items=await getCollection('qualificationPaths',({data})=>!data.draft);return items.map(item=>({params:{id:item.id},props:{item}}));} const {item}=Astro.props; const {Content}=await render(item);
---
<BaseLayout title={`${item.data.title} — Аттестация — СВАРКОД`} description={item.data.summary}><article class="entity-page"><header class="entity-hero shell"><div class="entity-kicker"><span>{item.data.role}</span><span class="verification verified">Проверено {formatDate(item.data.reviewedAt)}</span></div><h1>{item.data.title}</h1><p>{item.data.summary}</p></header><div class="article-content shell"><aside><strong>Маршрут</strong><span>Условия</span><span>Документы</span><span>Этапы</span><span>Сроки</span></aside><div>{item.data.prerequisites.length>0&&<><h2>Предварительные условия</h2><ul>{item.data.prerequisites.map(x=><li>{x}</li>)}</ul></>}{item.data.requiredDocuments.length>0&&<><h2>Документы</h2><ul>{item.data.requiredDocuments.map(x=><li>{x}</li>)}</ul></>}{item.data.steps.length>0&&<><h2>Шаги</h2><ol>{item.data.steps.map(x=><li>{x}</li>)}</ol></>}<Content/><div class="note"><strong>Граница ответственности</strong><p>Маршрут — редакционная навигация. Конкретную применимость определяют официальные требования и фактические условия работ.</p></div></div></div></article></BaseLayout>
