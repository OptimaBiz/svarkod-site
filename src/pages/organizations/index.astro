---
import {getCollection} from 'astro:content'; import BaseLayout from '../../layouts/BaseLayout.astro'; const orgs=await getCollection('organizations',({data})=>!data.draft);
---
<BaseLayout title="Организации — СВАРКОД"><header class="section-hero shell"><span class="kicker">РЕЕСТР</span><h1>Организации</h1><p>Совместимый адрес. Новый каталог: <a href="/registry/organizations/">Реестры → Организации</a>.</p></header><section class="shell org-grid">{orgs.map(o=><a class="org-card" href={`/organizations/${o.id}/`}><div class="org-top"><span>{o.data.type}</span><span class="verified">● {o.data.verification}</span></div><h2>{o.data.name}</h2><p>{o.data.region}</p></a>)}</section></BaseLayout>
