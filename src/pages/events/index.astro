---
import {getCollection} from 'astro:content'; import BaseLayout from '../../layouts/BaseLayout.astro'; import {formatDate} from '../../lib/content'; const events=(await getCollection('events',({data})=>!data.draft)).sort((a,b)=>a.data.startsAt.getTime()-b.data.startsAt.getTime());
---
<BaseLayout title="События — СВАРКОД"><header class="section-hero shell"><span class="kicker">КАЛЕНДАРЬ</span><h1>События</h1><p>Только проверенные мероприятия и нормативные даты.</p></header><section class="shell timeline">{events.map(e=><article><time><strong>{e.data.startsAt.getDate()}</strong><span>{formatDate(e.data.startsAt)}</span></time><div><span class="event-type">{e.data.category}</span><h2><a href={`/events/${e.id}/`}>{e.data.title}</a></h2><p>{e.data.description}</p><small>{e.data.location}</small></div><span class="event-arrow">→</span></article>)}{!events.length&&<div class="clean-empty"><h2>Проверенных событий пока нет</h2><p>Вымышленные мероприятия удалены.</p></div>}</section></BaseLayout>
