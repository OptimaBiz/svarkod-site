---
import {getCollection} from 'astro:content'; import BaseLayout from '../../layouts/BaseLayout.astro'; import {formatDate} from '../../lib/content'; const docs=await getCollection('documents',({data})=>!data.draft);
---
<BaseLayout title="Документы — СВАРКОД"><header class="section-hero shell"><span class="kicker">ПЕРВОИСТОЧНИКИ</span><h1>Документы</h1><p>Совместимый адрес каталога. Полная нормативная навигация находится в разделе <a href="/requirements/documents/">Требования → Документы</a>.</p></header><section class="shell document-table">{docs.map(d=><article><div class="doc-code"><span>{d.data.category}</span><strong>{d.data.status}</strong></div><div><h2><a href={`/documents/${d.id}/`}>{d.data.title}</a></h2><p>{d.data.description}</p></div><div class="doc-check"><span>Сверено</span><strong>{formatDate(d.data.verifiedAt||d.data.updatedAt)}</strong></div></article>)}</section></BaseLayout>
