---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { sections, articles } from '../data/site';
export function getStaticPaths() { return Object.keys(sections).map(section => ({ params: { section }, props: { section } })); }
const { section } = Astro.props;
const data = sections[section];
const pageArticles = section === 'services' ? articles.slice(0,3) : articles.filter(a => section === 'news' ? ['Новости','Интервью'].includes(a.section) : section === 'norms' ? a.section === 'Нормы' : section === 'practice' ? ['Практика','Технологии'].includes(a.section) : true);
---
<BaseLayout title={`${data.label} — СВАРКОД`} description={data.description}>
  <header class="page-hero shell"><p class="eyebrow">{data.accent}</p><h1>{data.title}</h1><p>{data.description}</p></header>
  {section === 'ratings' ? <section class="shell section-block cards-grid"><article class="rank-card"><span>01</span><p>Голосование открыто</p><h2>Аттестационные центры</h2><p>Сравнение по опыту специалистов, качеству сервиса и прозрачности процессов.</p><a class="button" href="/ratings/centers/">Открыть рейтинг</a></article><article class="rank-card"><span>02</span><p>Сбор данных</p><h2>Саморегулируемые организации</h2><p>Отраслевой обзор СРО с единой проверяемой методикой оценки.</p><a class="text-link" href="#method">Узнать о запуске →</a></article><article class="method-card" id="method"><p class="eyebrow">Принципы</p><h2>Рейтингу можно доверять</h2><ul><li>Один подтверждённый участник — один голос</li><li>Методика опубликована до начала голосования</li><li>Аномалии проверяются редакцией</li><li>Реклама не влияет на позицию</li></ul></article></section> : section === 'services' ? <section class="shell section-block"><div class="cards-grid"><article class="service-card"><span>01</span><h2>Нормативная навигация</h2><p>Поможем найти применимые требования и собрать карту документов для вашей задачи.</p><a href="/services/request/">Оставить заявку →</a></article><article class="service-card"><span>02</span><h2>Экспертный контент</h2><p>Подготовим технический материал, интервью или отраслевой обзор совместно с вашей командой.</p><a href="/services/request/">Обсудить материал →</a></article><article class="service-card"><span>03</span><h2>Реклама для B2B</h2><p>Нативные и медийные форматы для профессиональной аудитории сварочной отрасли.</p><a href="/advertising/">Смотреть форматы →</a></article></div></section> : <section class="shell section-block"><div class="article-grid">{pageArticles.length ? pageArticles.map((article, i) => <ArticleCard article={article} large={i === 0} />) : articles.map((article, i) => <ArticleCard article={article} large={i === 0} />)}</div></section>}
</BaseLayout>
