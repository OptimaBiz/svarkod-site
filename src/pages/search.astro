---
import {getCollection} from 'astro:content'; import BaseLayout from '../layouts/BaseLayout.astro';
const [articles,documents,organizations,events,requirements,paths]=await Promise.all([
 getCollection('articles',({data})=>!data.draft),getCollection('documents',({data})=>!data.draft),getCollection('organizations',({data})=>!data.draft),getCollection('events',({data})=>!data.draft),getCollection('requirements',({data})=>!data.draft),getCollection('qualificationPaths',({data})=>!data.draft)
]);
const items=[
 ...articles.map(x=>({kind:'Издание',type:x.data.section,title:x.data.title,desc:x.data.lead,url:`/articles/${x.id}/`})),
 ...documents.map(x=>({kind:'Документы',type:x.data.status,title:x.data.title,desc:x.data.description,url:`/documents/${x.id}/`})),
 ...requirements.map(x=>({kind:'Требования',type:x.data.subject,title:x.data.title,desc:x.data.summary,url:`/requirements/rules/${x.id}/`})),
 ...paths.map(x=>({kind:'Аттестация',type:x.data.role,title:x.data.title,desc:x.data.summary,url:`/certification/roadmaps/${x.id}/`})),
 ...organizations.map(x=>({kind:'Организации',type:x.data.type,title:x.data.name,desc:`${x.data.region} · ${x.data.description}`,url:`/organizations/${x.id}/`})),
 ...events.map(x=>({kind:'События',type:x.data.category,title:x.data.title,desc:x.data.description,url:`/events/${x.id}/`})),
];
const json=JSON.stringify(items).replace(/</g,'\\u003c');
---
<BaseLayout title="Поиск — СВАРКОД" noindex={true}><header class="search-page shell"><span class="kicker">ПО ВСЕЙ СИСТЕМЕ</span><h1>Поиск</h1><form id="search-form"><input id="q" type="search" placeholder="Требование, документ, центр, технология, организация…"/><button>Найти</button></form></header><section class="shell search-layout"><aside><strong>Тип</strong>{['Все','Издание','Документы','Требования','Аттестация','Организации','События'].map((x,i)=><button class={i===0?'active':''} data-kind={i===0?'':x}>{x}</button>)}</aside><div><div id="summary" class="search-summary">Введите запрос</div><div id="results" class="search-results"></div></div></section><script type="application/json" id="idx" set:html={json}></script><script>const data=JSON.parse(document.querySelector('#idx').textContent||'[]'),q=document.querySelector('#q'),r=document.querySelector('#results'),s=document.querySelector('#summary'),form=document.querySelector('#search-form'),buttons=[...document.querySelectorAll('[data-kind]')];let kind='';const norm=x=>String(x||'').toLowerCase().replace(/ё/g,'е');function render(){const query=norm(q.value).trim();r.replaceChildren();if(!query){s.textContent='Введите запрос';return}const terms=query.split(/\s+/);const found=data.filter(x=>(!kind||x.kind===kind)&&terms.every(t=>norm(`${x.title} ${x.desc} ${x.kind} ${x.type}`).includes(t)));s.textContent=`Найдено: ${found.length}`;found.forEach(x=>{const a=document.createElement('a');a.className='result-row';a.href=x.url;a.innerHTML=`<span></span><strong></strong><p></p><i>→</i>`;a.querySelector('span').textContent=`${x.kind} · ${x.type}`;a.querySelector('strong').textContent=x.title;a.querySelector('p').textContent=x.desc;r.append(a)})}form.addEventListener('submit',e=>{e.preventDefault();render()});buttons.forEach(b=>b.addEventListener('click',()=>{kind=b.dataset.kind||'';buttons.forEach(x=>x.classList.toggle('active',x===b));render()}));const initial=new URLSearchParams(location.search).get('q');if(initial){q.value=initial;render()}</script></BaseLayout>
