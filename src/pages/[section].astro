---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { sections } from '../data/site';
import { sortArticles, toArticleCard } from '../lib/content';

export function getStaticPaths() {
  return Object.keys(sections).map(section => ({ params: { section }, props: { section } }));
}

const { section } = Astro.props as { section: keyof typeof sections };
const data = sections[section];
const entries = sortArticles(await getCollection('articles', ({ data }) => !data.draft));
const filtered = entries.filter(entry => section === 'news' ? ['Новости','Интервью'].includes(entry.data.section) : section === 'norms' ? entry.data.section === 'Нормы' : section === 'practice' ? ['Практика','Технологии'].includes(entry.data.section) : false);
const pageArticles = filtered.map(toArticleCard);
---
<BaseLayout title={`${data.label} — СВАРКОД`} description={data.description}>
  <header class="page-hero shell"><p class="eyebrow">{data.accent}</p><h1>{data.title}</h1><p>{data.description}</p></header>
  {section === 'ratings' ? <section class="shell section-block cards-grid"><article class="rank-card"><span>01</span><p>Подготовка</p><h2>Аттестационные центры</h2><p>До запуска рейтинга публикуем только статус методики и правила проверки.</p><a class="button" href="/ratings/centers/">Статус рейтинга</a></article><article class="rank-card"><span>02</span><p>Следующий этап</p><h2>Саморегулируемые организации</h2><p>Категория будет запущена только после отдельной методической проработки и проверки источников.</p></article><article class="method-card" id="method"><p class="eyebrow">Принципы</p><h2>Что потребуется до запуска</h2><ul><li>Опубликованная методика и критерии</li><li>Проверяемый механизм верификации</li><li>Защита от повторных и аномальных голосов</li><li>Журнал изменений и пересмотров</li><li>Разделение рекламы и рейтинговой оценки</li></ul></article></section> : section === 'services' ? <section class="shell section-block"><div class="cards-grid"><article class="service-card"><span>01</span><h2>Нормативная навигация</h2><p>Поможем собрать карту источников и вопросов для дальнейшей профильной проверки.</p><a href="/services/request/">Оставить заявку →</a></article><article class="service-card"><span>02</span><h2>Экспертный контент</h2><p>Подготовим технический материал, интервью или отраслевой обзор совместно с вашей командой.</p><a href="/services/request/">Обсудить материал →</a></article><article class="service-card"><span>03</span><h2>Реклама для B2B</h2><p>Нативные и медийные форматы для профессиональной аудитории сварочной отрасли.</p><a href="/advertising/">Смотреть форматы →</a></article></div></section> : <section class="shell section-block"><div class="article-grid">{pageArticles.map((article, i) => <ArticleCard article={article} large={i === 0} />)}</div></section>}
</BaseLayout>
