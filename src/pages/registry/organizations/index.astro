---
import {getCollection} from 'astro:content'; import BaseLayout from '../../../layouts/BaseLayout.astro';
const orgs=await getCollection('organizations',({data})=>!data.draft);
---
<BaseLayout title="Организации — Реестр — СВАРКОД"><header class="section-hero shell"><span class="kicker">РЕЕСТР</span><h1>Организации</h1><p>Проверяемые профили: идентификация, тип, регион, источник и дата редакционной сверки.</p></header><section class="shell directory-shell"><div class="filter-bar"><input id="org-q" placeholder="Название, регион, тип"/><select id="org-type"><option value="">Все типы</option>{[...new Set(orgs.map(o=>o.data.type))].map(t=><option>{t}</option>)}</select><span><strong id="org-count">{orgs.length}</strong> профилей</span></div><div class="org-grid">{orgs.map(o=><a class="org-card" href={`/organizations/${o.id}/`} data-org data-search={`${o.data.name} ${o.data.region} ${o.data.type}`} data-type={o.data.type}><div class="org-top"><span>{o.data.type}</span><span class:list={['verified',{pending:o.data.verification!=='Проверено редакцией'}]}>● {o.data.verification}</span></div><h2>{o.data.name}</h2><p>{o.data.city?`${o.data.city}, `:''}{o.data.region}</p><div class="org-bottom"><strong>→</strong><span>Открыть проверяемый профиль</span></div></a>)}</div>{!orgs.length&&<div class="clean-empty"><h2>Публичный реестр пуст</h2><p>Вымышленные организации не используются для заполнения каталога.</p></div>}</section><script>const q=document.querySelector('#org-q');const s=document.querySelector('#org-type');const cards=[...document.querySelectorAll('[data-org]')];const c=document.querySelector('#org-count');function f(){let n=0;cards.forEach(x=>{const ok=(!q.value||x.dataset.search.toLowerCase().includes(q.value.toLowerCase()))&&(!s.value||x.dataset.type===s.value);x.hidden=!ok;if(ok)n++});c.textContent=String(n)}q?.addEventListener('input',f);s?.addEventListener('change',f);</script></BaseLayout>
